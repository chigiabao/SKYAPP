# Copy to .env (never commit .env). Used by docker-compose.yml; see docs/deploy.md for every variable.

# --- Security ---------------------------------------------------------------------------------------
# Required behind a reverse proxy: /admin/* then needs header X-Admin-Token. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Placeholders (change-me, ...) and tokens shorter than 24 characters are refused: /admin/* answers 503.
# Empty = /admin/* only for direct non-browser requests from localhost (never through Docker port mapping).
ADMIN_TOKEN=
ENABLE_DOCS=0
# Comma-separated browser origins of the Flutter web app (mobile apps send no Origin). `*` = any origin.
# Dev example: http://localhost:8080,http://127.0.0.1:8080,http://localhost:8112
CORS_ORIGINS=https://weather.example.com
# Auth uses Authorization: Bearer (no cookies) -> keep 0. Ignored when CORS_ORIGINS=*.
CORS_ALLOW_CREDENTIALS=0

# --- Password recovery (missing SMTP configuration returns 503 for every address) ------------------
# Inject into the backend process/container; Python does not load this file automatically.
# Verified TLS only: starttls (usually 587) or ssl (usually 465). No plaintext mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
# Bare sender address authorized by your email provider.
SMTP_FROM=
SMTP_USERNAME=
# Set through your deployment secret store; never commit a real password here.
SMTP_PASSWORD=

# --- Rate limit (per client IP, per process; 0 = off) -----------------------------------------------
RATE_LIMIT_PER_MINUTE=120
# 1 only when the API is reachable exclusively through your reverse proxy (it must append X-Forwarded-For).
TRUST_PROXY=1

# --- Ingest -----------------------------------------------------------------------------------------
INGEST_ENABLED=1
# Optional cold-start window for new series only (3..90 days; default90).
# Render demo uses3; existing series keep the normal48-hour revision overlap.
# INGEST_BACKFILL_DAYS=3
# Retention follows INGEST_ENABLED unless overridden; enable on exactly one writable replica.
# MAINTENANCE_ENABLED=1
EXTERNAL_FORECAST_ENABLED=0
ALERT_FAILURE_THRESHOLD=3
ALERT_STALE_HOURS=6
# Optional: JSON POST target (Slack/Discord-compatible relay, healthchecks, ...). Empty = log only.
ALERT_WEBHOOK_URL=

# --- Models -----------------------------------------------------------------------------------------
# Served long-range model directory (default backend/models/long_range_v2). LONG_RANGE_MODEL_DIR only
# affects the legacy v1 module used by research scripts; the API does not read it.
# LONG_RANGE_V2_MODEL_DIR=/app/models/long_range_v2

# --- Logging / container ----------------------------------------------------------------------------
LOG_LEVEL=INFO
API_PORT=8000
APP_UID=10001
